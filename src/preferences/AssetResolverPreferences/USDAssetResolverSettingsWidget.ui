    <widget class="QCheckBox" name="includeProjectTokens">
     <property name="toolTip">
      <string>Enable this option to let the USD Asset Resolver use the directories defined in 3ds Max’s project window as search tokens. When on, your current 3ds Max project folders automatically become tokenized search locations.</string>
     </property>
     <property name="text">
      <string>Include Project Tokens</string>
