    def Scope "mtl"
    {
        def Material "Iberian_Blue_Ceramic_Tiles"
        {
            token outputs:mtlx:surface.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/Iberian_Blue_Ceramic_Tiles.outputs:out>

            def Shader "Iberian_Blue_Ceramic_Tiles"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0.8
                color3f inputs:base_color.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles.outputs:base_color_output>
                float inputs:coat = 0
                float inputs:coat_affect_color = 0
                float inputs:coat_affect_roughness = 0
                color3f inputs:coat_color = (1, 1, 1)
                float inputs:coat_IOR = 1.5
                float3 inputs:coat_normal.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles.outputs:coat_normal_output>
                float inputs:coat_roughness = 0.1
                float inputs:diffuse_roughness = 0
                float inputs:emission = 0
                color3f inputs:emission_color = (1, 1, 1)
                float inputs:metalness.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles.outputs:metalness_output>
                float3 inputs:normal.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles.outputs:normal_output>
                float inputs:specular = 1
                color3f inputs:specular_color = (1, 1, 1)
                float inputs:specular_IOR = 1.5
                float inputs:specular_rotation = 0
                float inputs:specular_roughness.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles.outputs:specular_roughness_output>
                float inputs:subsurface = 0
                color3f inputs:subsurface_color = (1, 1, 1)
                color3f inputs:subsurface_radius = (1, 1, 1)
                float inputs:subsurface_scale = 1
                bool inputs:thin_walled = 0
                float inputs:transmission = 0
                color3f inputs:transmission_color = (1, 1, 1)
                float inputs:transmission_depth = 0
                token outputs:out
            }

            def NodeGraph "NG_Iberian_Blue_Ceramic_Tiles" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                color3f outputs:base_color_output.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_tiledimage_color3_0.outputs:out>
                float3 outputs:coat_normal_output.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/nm.outputs:out>
                float outputs:metalness_output.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_extract_7.outputs:out>
                float3 outputs:normal_output.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_normalmap.outputs:out>
                float outputs:specular_roughness_output.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_mix_8.outputs:out>

                def Shader "node_texcoord_vector2_2" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_texcoord_vector2"
                    int inputs:index = 0
                    float2 outputs:out
                }

                def Shader "UVScale" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_constant_float"
                    float inputs:value = 1
                    float outputs:out
                }

                def Shader "node_multiply_1" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_multiply_vector2FA"
                    float2 inputs:in1.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_texcoord_vector2_2.outputs:out>
                    float inputs:in2.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/UVScale.outputs:out>
                    float2 outputs:out
                }

                def Shader "node_tiledimage_color3_0" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_tiledimage_color3"
                    color3f inputs:default = (0, 0, 0)
                    asset inputs:file = @textures/Iberian_Blue_Ceramic_Tiles_baseColor.png@ (
                        colorSpace = "srgb_texture"
                    )
                    string inputs:filtertype = "linear"
                    string inputs:frameendaction = "constant"
                    int inputs:frameoffset = 0
                    float2 inputs:realworldimagesize = (1, 1)
                    float2 inputs:realworldtilesize = (1, 1)
                    float2 inputs:texcoord.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_multiply_1.outputs:out>
                    float2 inputs:uvoffset = (0, 0)
                    float2 inputs:uvtiling = (1, 1)
                    color3f outputs:out
                }

                def Shader "RoughnessHigh" (
