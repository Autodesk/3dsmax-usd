                )
                {
                    uniform token info:id = "ND_image_vector3"
                    float3 inputs:default = (0, 0, 0)
                    asset inputs:file = @textures/Iberian_Blue_Ceramic_Tiles_roughness.png@
                    string inputs:filtertype = "linear"
                    string inputs:frameendaction = "constant"
                    int inputs:frameoffset = 0
                    float2 inputs:texcoord.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_multiply_1.outputs:out>
                    string inputs:uaddressmode = "periodic"
                    string inputs:vaddressmode = "periodic"
                    float3 outputs:out
                }

                def Shader "node_extract_3" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_extract_vector3"
                    float3 inputs:in.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_image_vector3_4.outputs:out>
                    int inputs:index = 1
                    float outputs:out
                }

                def Shader "node_mix_8" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_mix_float"
                    float inputs:bg.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/RoughnessLow.outputs:out>
                    float inputs:fg.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/RoughnessHigh.outputs:out>
                    float inputs:mix.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_extract_3.outputs:out>
                    float outputs:out
                }

                def Shader "node_extract_7" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_extract_vector3"
                    float3 inputs:in.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_image_vector3_4.outputs:out>
                    int inputs:index = 2
                    float outputs:out
                }

                def Shader "node_image_vector3_6" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_image_vector3"
                    float3 inputs:default = (0, 0, 0)
                    asset inputs:file = @textures/Iberian_Blue_Ceramic_Tiles_normal.png@
                    string inputs:filtertype = "linear"
                    string inputs:frameendaction = "constant"
                    int inputs:frameoffset = 0
                    float2 inputs:texcoord.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_multiply_1.outputs:out>
                    string inputs:uaddressmode = "periodic"
                    string inputs:vaddressmode = "periodic"
                    float3 outputs:out
                }

                def Shader "node_normalmap" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_normalmap"
                    float3 inputs:in.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/node_image_vector3_6.outputs:out>
                    float inputs:scale = -1
                    float3 outputs:out
                }

                def Shader "onthefly_9" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_normal_vector3"
                    string inputs:space = "world"
                    float3 outputs:out
                }

                def Shader "nm" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "ND_normalmap"
                    float3 inputs:in.connect = </root/mtl/Iberian_Blue_Ceramic_Tiles/NG_Iberian_Blue_Ceramic_Tiles/onthefly_9.outputs:out>
                    float inputs:scale = 1
